{
  "name": "ng2-daterangepicker",
  "version": "2.1.9",
  "description": "Angular DateRangePicker component",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "cd projects && cd ng2-daterangepicker && npm run build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evansmwendwa/ng2-daterangepicker"
  },
  "bugs": {
    "url": "https://github.com/evansmwendwa/ng2-daterangepicker/issues"
  },
  "homepage": "https://github.com/evansmwendwa/ng2-daterangepicker#readme",
  "license": "MIT",
  "module": "dist/ng2-daterangepicker/fesm2022/ng2-daterangepicker.mjs",
  "typings": "dist/ng2-daterangepicker/types/ng2-daterangepicker.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    "./daterangepicker.component.css": {
      "default": "./dist/ng2-daterangepicker/daterangepicker.component.css"
    },
    ".": {
      "types": "./dist/ng2-daterangepicker/types/ng2-daterangepicker.d.ts",
